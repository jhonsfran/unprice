diff --git a/dist/zod-to-json-schema.js b/dist/zod-to-json-schema.js
new file mode 100644
index 0000000000000000000000000000000000000000..e863989c7ef8d6338620b4ad9c0965fcf8cec0e9
--- /dev/null
+++ b/dist/zod-to-json-schema.js
@@ -0,0 +1,46 @@
+import { z } from 'zod';
+
+// Keep Mintlify's named draft-7 definitions while using the v4 schema visitor.
+export function zodToJsonSchema(schema, options = {}) {
+    const named = typeof options === 'string';
+    const rootId = named ? options : '__root';
+    const registry = z.registry();
+    const aliases = {};
+    for (const [id, definition] of Object.entries(named ? {} : options.definitions ?? {})) {
+        const existing = registry.get(definition);
+        if (existing) aliases[id] = { $ref: `#/definitions/${existing.id}` };
+        else registry.add(definition, { id });
+    }
+    registry.add(schema, { id: rootId });
+    const { schemas } = z.toJSONSchema(registry, {
+        target: 'draft-7',
+        io: 'input',
+        reused: 'ref',
+        override: ({ zodSchema, jsonSchema }) => {
+            if (zodSchema._zod.def.type === 'object' && !zodSchema._zod.def.catchall) {
+                jsonSchema.additionalProperties = false;
+            }
+        },
+        uri: (id) => !named && id === rootId ? '#' : `#/definitions/${id}`,
+    });
+    for (const definition of Object.values(schemas)) {
+        delete definition.$id;
+        delete definition.$schema;
+    }
+    // Registry references target separate documents; embed their fragments under definitions.
+    function localizeRefs(value) {
+        if (!value || typeof value !== 'object') return;
+        if (typeof value.$ref === 'string' && value.$ref.startsWith('#/definitions/')) {
+            value.$ref = '#' + value.$ref.slice(1).replaceAll('#', '');
+        }
+        for (const child of Object.values(value)) localizeRefs(child);
+    }
+    localizeRefs(schemas);
+    const root = schemas[rootId];
+    if (!named) delete schemas[rootId];
+    return {
+        $schema: 'http://json-schema.org/draft-07/schema#',
+        ...(named ? { $ref: `#/definitions/${rootId}` } : root),
+        definitions: { ...schemas, ...aliases },
+    };
+}
