exports[`listPlanVersions snippet text > sdk keeps the exact default request and follow-up 1`] = `
"import { Unprice } from "@unprice/api"

const unprice = new Unprice({
  token: process.env.UNPRICE_TOKEN!,
  baseUrl: "http://localhost:8787",
})

const { result, error } = await unprice.planVersions.list({
  billingInterval: "month",
  currency: "USD",
})

if (error) {
  console.error(error.message)
  return
}

const [planVersion] = result.planVersions
const featureSlugs =
  planVersion?.planFeatures.map((planFeature) => planFeature.feature.slug) ?? []
"
`;

