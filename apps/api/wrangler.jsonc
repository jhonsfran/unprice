/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-19",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "env": {
    "prod": {
      "workers_dev": false,
      "observability": {
        "logs": {
          "enabled": false,
          "invocation_logs": true,
          "persist": false
        }
      },
      "route": {
        "pattern": "api.unprice.dev",
        "custom_domain": true
      },
      "unsafe": {
        "bindings": [
          {
            "name": "RL_FREE_1000_60s",
            "type": "ratelimit",
            "namespace_id": "1001",
            "simple": {
              "limit": 1000, // for other important endpoint keep it lower
              "period": 60
            }
          },
          {
            "name": "RL_FREE_6000_60s",
            "type": "ratelimit",
            "namespace_id": "1002",
            "simple": {
              "limit": 6000, // 100 requests per second
              "period": 60
            }
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "projectdo",
            "class_name": "DurableObjectProject"
          },
          {
            "name": "budget",
            "class_name": "BudgetDO"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v2",
          "new_sqlite_classes": ["DurableObjectProject"]
        },
        {
          "tag": "v3",
          "new_sqlite_classes": ["EntitlementWindowDO"]
        },
        {
          "tag": "v4",
          "new_sqlite_classes": ["IngestionAuditDO"]
        },
        {
          "tag": "v5",
          "deleted_classes": ["IngestionAuditDO"]
        },
        {
          "tag": "v6",
          "new_sqlite_classes": ["RunBudgetDO"]
        },
        {
          "tag": "v7",
          "new_sqlite_classes": ["BudgetDO"]
        },
        {
          "tag": "v8",
          "deleted_classes": ["EntitlementWindowDO", "RunBudgetDO"]
        }
      ]
    },
    "preview": {
      "workers_dev": false,
      "observability": {
        "logs": {
          "enabled": false,
          "invocation_logs": true,
          "persist": false
        },
        "traces": {
          "enabled": false
        }
      },
      "route": {
        "pattern": "preview-api.unprice.dev",
        "custom_domain": true
      },
      "unsafe": {
        // # Limit: the number of tokens allowed within a given period in a single
        // # Cloudflare location
        // # Period: the duration of the period, in seconds. Must be either 10 or 60
        "bindings": [
          {
            "name": "RL_FREE_1000_60s",
            "type": "ratelimit",
            "namespace_id": "1001",
            "simple": {
              "limit": 1000,
              "period": 60
            }
          },
          {
            "name": "RL_FREE_6000_60s",
            "type": "ratelimit",
            "namespace_id": "1002",
            "simple": {
              "limit": 6000, // 100 requests per second
              "period": 60
            }
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "projectdo",
            "class_name": "DurableObjectProject"
          },
          {
            "name": "budget",
            "class_name": "BudgetDO"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v2",
          "new_sqlite_classes": ["DurableObjectProject"]
        },
        {
          "tag": "v3",
          "new_sqlite_classes": ["EntitlementWindowDO"]
        },
        {
          "tag": "v4",
          "new_sqlite_classes": ["IngestionAuditDO"]
        },
        {
          "tag": "v5",
          "deleted_classes": ["IngestionAuditDO"]
        },
        {
          "tag": "v6",
          "new_sqlite_classes": ["RunBudgetDO"]
        },
        {
          "tag": "v7",
          "new_sqlite_classes": ["BudgetDO"]
        },
        {
          "tag": "v8",
          "deleted_classes": ["EntitlementWindowDO", "RunBudgetDO"]
        }
      ]
    },
    "dev": {
      "workers_dev": true,
      "unsafe": {
        // # Limit: the number of tokens allowed within a given period in a single
        // # Cloudflare location
        // # Period: the duration of the period, in seconds. Must be either 10 or 60
        "bindings": [
          {
            "name": "RL_FREE_1000_60s",
            "type": "ratelimit",
            "namespace_id": "1001",
            "simple": {
              "limit": 1000,
              "period": 60
            }
          },
          {
            "name": "RL_FREE_6000_60s",
            "type": "ratelimit",
            "namespace_id": "1002",
            "simple": {
              "limit": 6000, // 100 requests per second
              "period": 60
            }
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "projectdo",
            "class_name": "DurableObjectProject"
          },
          {
            "name": "budget",
            "class_name": "BudgetDO"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v2",
          "new_sqlite_classes": ["DurableObjectProject"]
        },
        {
          "tag": "v3",
          "new_sqlite_classes": ["EntitlementWindowDO"]
        },
        {
          "tag": "v4",
          "new_sqlite_classes": ["IngestionAuditDO"]
        },
        {
          "tag": "v5",
          "deleted_classes": ["IngestionAuditDO"]
        },
        {
          "tag": "v6",
          "new_sqlite_classes": ["RunBudgetDO"]
        },
        {
          "tag": "v7",
          "new_sqlite_classes": ["BudgetDO"]
        },
        {
          "tag": "v8",
          "deleted_classes": ["EntitlementWindowDO", "RunBudgetDO"]
        }
      ]
    }
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.sql"],
      "fallthrough": true
    }
  ]
  // disable smart placement for now
  // "placement": {
  //   "mode": "smart"
  // },
  /**
   * Smart Placement
   * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  // "placement": { "mode": "smart" },
  /**
   * Bindings
   * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
   * databases, object storage, AI inference, real-time communication and more.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */
  /**
   * Environment Variables
   * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
   */
  // "vars": { "MY_VARIABLE": "production_value" },
  /**
   * Note: Use secrets to store sensitive data.
   * https://developers.cloudflare.com/workers/configuration/secrets/
   */
  /**
   * Static Assets
   * https://developers.cloudflare.com/workers/static-assets/binding/
   */
  // "assets": { "directory": "./public/", "binding": "ASSETS" },
  /**
   * Service Bindings (communicate between multiple Workers)
   * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
   */
  // "services": [{ "binding": "MY_SERVICE", "service": "my-service" }]
}
