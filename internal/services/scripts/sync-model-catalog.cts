// CommonJS on purpose: `@unprice/error` is untyped CommonJS whose `export *` barrel hides its
// names from Node's ESM loader, so an ESM entry cannot reach `@unprice/db/validators` under tsx.
import { execFileSync } from "node:child_process"
import { readFile, writeFile } from "node:fs/promises"
import { resolve } from "node:path"
import { fromModelsDev } from "../src/budgets/model-catalog"

const SOURCE_URL = "https://models.dev/api.json"

const outputPath = resolve(__dirname, "../src/budgets/model-catalog.data.ts")

async function readDocument(path: string | undefined): Promise<unknown> {
  if (path) return JSON.parse(await readFile(path, "utf8"))
  const response = await fetch(SOURCE_URL)
  if (!response.ok) throw new Error(`${SOURCE_URL} answered ${response.status}`)
  return response.json()
}

async function main() {
  const rows = fromModelsDev(await readDocument(process.argv[2]))
  const version = new Date().toISOString().slice(0, 10)
  const source = [
    `// Generated by internal/services/scripts/sync-model-catalog.cts from ${SOURCE_URL}.`,
    "// Regenerate with `pnpm --filter @unprice/services sync:model-catalog`; do not edit by hand.",
    "",
    'import type { ModelRate } from "@unprice/db/validators"',
    "",
    `export const MODEL_CATALOG_VERSION = ${JSON.stringify(version)}`,
    "",
    `export const MODEL_CATALOG: readonly ModelRate[] = ${JSON.stringify(rows, null, 2)}`,
    "",
  ].join("\n")
  await writeFile(outputPath, source, "utf8")
  execFileSync("pnpm", ["biome", "format", outputPath, "--write"], { stdio: "ignore" })
  process.stdout.write(`wrote ${rows.length} models, version ${version}, to ${outputPath}\n`)
}

main().catch((error) => {
  console.error("failed to sync the model catalog", error)
  process.exit(1)
})
