TOKEN "web-apps" READ

TAGS "usage, billing"

DESCRIPTION >
    Get accepted usage and signed prices per grant reset bucket within a billing window.

NODE billing_usage_allocation_facts_node
SQL >
    %
    SELECT
        project_id,
        customer_id,
        customer_entitlement_id,
        grant_id,
        period_key,
        feature_slug,
        idempotency_key,
        argMax(tuple(delta, amount, currency, amount_scale), tuple(created_at, event_id)) AS fact
    FROM unprice_entitlement_meter_facts
    WHERE
        project_id = {{ String(project_id) }}
        AND customer_id = {{ String(customer_id) }}
        AND customer_entitlement_id IN {{ Array(customer_entitlement_ids, 'String') }}
        AND feature_slug IN {{ Array(feature_slugs, 'String') }}
        AND timestamp >= {{ Int64(start) }} AND timestamp < {{ Int64(end) }}
    GROUP BY project_id, customer_id, customer_entitlement_id, grant_id, period_key, feature_slug, idempotency_key

NODE billing_usage_allocations_node
SQL >
    %
    SELECT
        customer_entitlement_id,
        grant_id,
        period_key,
        feature_slug,
        toInt64(arrayElement(splitByChar(':', period_key), 2)) AS period_start_at,
        toFloat64(sum(tupleElement(fact, 1))) AS usage,
        toFloat64(sum(toInt128(tupleElement(fact, 2)))) AS amount,
        tupleElement(fact, 3) AS currency,
        tupleElement(fact, 4) AS amount_scale
    FROM billing_usage_allocation_facts_node
    GROUP BY customer_entitlement_id, grant_id, period_key, feature_slug, currency, amount_scale
    ORDER BY period_start_at, grant_id

TYPE endpoint
