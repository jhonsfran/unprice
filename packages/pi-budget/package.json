    "directory": "packages/pi-budget"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@unprice/budgets": "workspace:^",
    "@unprice/budgets-ai": "workspace:^",
    "zod": "^3.24.2"
