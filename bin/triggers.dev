#!/usr/bin/env bash

# Please Use Google Shell Style: https://google.github.io/styleguide/shell.xml

# ---- Start unofficial bash strict mode boilerplate
# http://redsymbol.net/articles/unofficial-bash-strict-mode/
set -o errexit  # always exit on error
set -o errtrace # trap errors in functions as well
set -o pipefail # don't ignore exit codes when piping output
set -o posix    # more strict failures in subshells
# set -x          # enable debugging

cd "$(dirname "${BASH_SOURCE[0]}")/.."

export NVM_DIR="$HOME/.nvm"
# shellcheck disable=SC1090
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

echo "Starting up"

# lets check first that docker and node are installed
if ! command -v docker &> /dev/null; then
  echo "Docker could not be found"
  exit 1
fi

if ! command -v docker-compose &> /dev/null; then
  echo "Docker Compose could not be found"
  exit 1
fi

if ! command -v node &> /dev/null; then
  echo "Node could not be found"
  exit 1
fi

# start the docker compose services
docker-compose up -d

# use the correct node version
nvm use

# take the first parameter as the mode id if not provided, use dev
MODE_ID=${1:-dev}

if [ "$MODE_ID" = "dev" ]; then
  # banner to show the user that we are using the preview environment
  echo ""
  echo "########################################################"
  echo "# Using development environment"
  echo "########################################################"
  echo ""

  NODE_ENV="development"
  APP_ENV="development"
  # REDIS_URL="http://localhost:8079"
  AUTH_REDIRECT_PROXY_URL="http://localhost:3100/auth"
  # REDIS_TOKEN="example_token"
  UNPRICE_API_URL="http://localhost:8787"
  # INFO: Replace with local key
  UNPRICE_API_KEY="unprice_dev_1234567890"
  DRIZZLE_LOG="false"
  UPSTASH_REDIS_REST_URL="http://localhost:8079"
  UPSTASH_REDIS_REST_TOKEN="unprice"

  echo "Applying migrations"
  infisical run --env=preview --path=/ --recursive -- env AUTH_REDIRECT_PROXY_URL=$AUTH_REDIRECT_PROXY_URL UNPRICE_API_URL=$UNPRICE_API_URL UNPRICE_API_KEY=$UNPRICE_API_KEY DRIZZLE_LOG=$DRIZZLE_LOG NODE_ENV=$NODE_ENV APP_ENV=$APP_ENV pnpm --filter db migrate:custom

  echo "Starting the application"
  infisical run --env=preview --path=/ --recursive -- env AUTH_REDIRECT_PROXY_URL=$AUTH_REDIRECT_PROXY_URL UNPRICE_API_URL=$UNPRICE_API_URL UNPRICE_API_KEY=$UNPRICE_API_KEY DRIZZLE_LOG=$DRIZZLE_LOG UPSTASH_REDIS_REST_URL=$UPSTASH_REDIS_REST_URL UPSTASH_REDIS_REST_TOKEN=$UPSTASH_REDIS_REST_TOKEN NODE_ENV=$NODE_ENV APP_ENV=$APP_ENV pnpm --filter jobs run dev:trigger

elif [ "$MODE_ID" = "preview" ]; then
  # banner to show the user that we are using the preview environment
  # TODO: Preview should use the preview database as well
  echo ""
  echo "########################################################"
  echo "# Using preview environment"
  echo "########################################################"
  echo ""

  NODE_ENV="production"
  APP_ENV="preview"

  infisical run --env=preview --path=/ --recursive -- env NODE_ENV="$NODE_ENV" APP_ENV="$APP_ENV" pnpm run dev
else
  echo "Invalid mode: $MODE_ID"
  exit 1
fi

