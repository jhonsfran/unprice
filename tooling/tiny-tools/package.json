{
  "name": "@unprice/tiny-tools",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "cookie": "node --env-file-if-exists=.env --import=tsx cookie.ts",
    "main": "node --env-file-if-exists=.env --import=tsx main.ts",
    "e2e": "node --env-file-if-exists=.env --import=tsx main.ts",
    "e2e:local": "UNPRICE_API_URL=http://localhost:8787 node --env-file-if-exists=.env --import=tsx main.ts",
    "e2e:signup": "node --env-file-if-exists=.env --import=tsx plan-signup.ts",
    "e2e:signup:local": "UNPRICE_API_URL=http://localhost:8787 node --env-file-if-exists=.env --import=tsx plan-signup.ts",
    "e2e:usage": "node --env-file-if-exists=.env --import=tsx plan-usage.ts",
    "e2e:usage:local": "UNPRICE_API_URL=http://localhost:8787 node --env-file-if-exists=.env --import=tsx plan-usage.ts",
    "e2e:wallet": "node --env-file-if-exists=.env --import=tsx plan-wallet.ts",
    "e2e:wallet:local": "UNPRICE_API_URL=http://localhost:8787 node --env-file-if-exists=.env --import=tsx plan-wallet.ts",
    "clean": "git clean -xdf .next .turbo node_modules",
    "with-env": "infisical run --env=preview --path=/app --"
  },
  "keywords": [],
  "author": "Sebastian Franco",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@unprice/api": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "@unprice/tsconfig": "workspace:*",
    "tsx": "^4.7.2",
    "typescript": "^5.3.3"
  }
}
