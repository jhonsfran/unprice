{
  "name": "@unprice/k6",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "can.js",
  "scripts": {
    "build:baseline": "pnpm typecheck && esbuild baseline.ts --bundle --platform=browser --format=esm --external:k6 --external:k6/* --outfile=dist/baseline.js",
    "build:lifecycle": "pnpm typecheck && esbuild lifecycle.ts --bundle --platform=browser --format=esm --external:k6 --external:k6/* --outfile=dist/lifecycle.js",
    "typecheck": "../../node_modules/.bin/tsc --noEmit",
    "build:latency": "pnpm typecheck && esbuild latency.ts --bundle --platform=browser --format=esm --external:k6 --external:k6/* --outfile=dist/latency.js",
    "build:budgets": "pnpm typecheck && esbuild budgets.ts --bundle --platform=browser --format=esm --external:k6 --external:k6/* --outfile=dist/budgets.js",
    "baseline": "pnpm build:baseline && sh ./scripts/run-baseline.sh dist/baseline.js",
    "lifecycle": "pnpm build:lifecycle && docker run --env-file .env --rm --network=host -i grafana/k6 run - < dist/lifecycle.js",
    "load-test:production": "node --env-file-if-exists=.env --import=tsx load-test-production.ts",
    "budget-local": "pnpm --filter @unprice/budgets build && node --env-file-if-exists=.env --import=tsx budget-local.ts",
    "latency": "pnpm build:latency && sh ./scripts/run-k6.sh dist/latency.js",
    "budgets": "pnpm build:budgets && sh ./scripts/run-k6.sh dist/budgets.js"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@unprice/api": "workspace:^",
    "@unprice/budgets": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "esbuild": "0.25.12",
    "k6": "^0.0.0",
    "tsx": "^4.7.2"
  }
}
