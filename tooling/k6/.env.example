UNPRICE_TOKEN=unprice_test_xxx
# Required by the production load-test orchestrator. Configuration keys cannot send usage.
UNPRICE_CONFIG_TOKEN=unprice_config_xxx
BASE_URL=http://localhost:8787
PROJECT_ID=proj_xxx
CUSTOMER_ID=cus_xxx
EVENTS=1000

# Required when BASE_URL is https://api.unprice.dev.
# CONFIRM_PRODUCTION_LOAD_TEST=yes
# INGESTION_TIMEOUT_SECONDS=120

# Latency benchmark (pnpm --filter @unprice/k6 latency)
# RATE=20
# DURATION=60s
# FEATURE_SLUG=tokens
# Cold path: creates real customers — disposable load-test projects only.
# COLD_SIGNUPS=20
# PLAN_SLUG=pro

# Budgets concurrency, accuracy, and latency (pnpm --filter @unprice/k6 budgets)
# Needs only UNPRICE_TOKEN and BASE_URL; creates fresh budgets under k6:budgets/<timestamp>.
# RATE=50
# DURATION=30s
# VUS=50
# KEYS=1
# LIMIT=200
# RECORD_RATE=5
# DUPLICATE_PERCENT=10
# P95_MS=500
# P99_MS=1500
