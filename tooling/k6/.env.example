# Budgeted runs test (uncomment only the scenario-specific overrides you need)
# BUDGET_AMOUNT=10000
# CURRENCY=USD
# EVENTS_PER_RUN=50
# RUNS=10
# VUS=5

# Overspend test (manual/nightly only)
# BUDGET_AMOUNT=100
# ATTEMPTS=200
# VUS=10

# Latency benchmark (pnpm --filter @unprice/k6 latency)
# RATE=20
# DURATION=60s
# FEATURE_SLUG=tokens
# Cold path: creates real customers — disposable load-test projects only.
# COLD_SIGNUPS=20
# PLAN_SLUG=pro
